# .env.example — Template de configuration
# Copier ce fichier en .env et renseigner les valeurs réelles
# NE JAMAIS commiter le fichier .env (il est dans .gitignore)

# ─────────────────────────────────────────
# Azure OpenAI
# ─────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<votre-cle-api-openai>
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_TEMPERATURE=0.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ─────────────────────────────────────────
# Azure Bot Service / Bot Framework
# ─────────────────────────────────────────
# Laisser vides en développement local
# À remplir après création de la ressource Azure Bot Service sur le portail Azure
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=

# ─────────────────────────────────────────
# Azure AI Search
# ─────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://<votre-ressource>.search.windows.net
AZURE_SEARCH_API_KEY=<votre-cle-api-search>
AZURE_SEARCH_INDEX_NAME=smartovate-index

# ─────────────────────────────────────────
# Direct Line (Web Chat)
# ─────────────────────────────────────────
# Clé secrète Direct Line — portail Azure Bot Service → Canaux → Direct Line → Clés secrètes
# Laisser vide en développement local (token simulé retourné par /api/chat/token)
DIRECT_LINE_SECRET=
APP_NAME=Smartovate Chatbot
APP_VERSION=1.0.0
DEBUG=false

# Seuil de confiance pour déclencher le handoff vers un agent humain (entre 0.0 et 1.0)
APP_CONFIDENCE_THRESHOLD=0.7
